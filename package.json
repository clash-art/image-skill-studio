{
  "name": "image-skill-studio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "dev:plugin": "node scripts/watch-plugin.mjs",
    "build:widget": "node scripts/build-widget.mjs",
    "build:plugin:server": "node scripts/build-plugin.mjs",
    "build:plugin": "npm run build:widget && npm run build:plugin:server",
    "build:preview": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build": "npm run build:plugin && npm run build:preview",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "pretest": "npm run build:plugin",
    "test": "node --test tests/*.test.mjs && npm run build:preview",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern runtime --ignore-pattern work --ignore-pattern public/widget.html",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/react": "^1.1.9",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
